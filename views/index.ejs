<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seat Booking</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="min-h-screen bg-gray-100">
    <!-- Header -->
    <div class="flex justify-between items-center px-6 py-4 bg-white shadow">
      <h1 class="text-xl font-semibold text-gray-800">🎬 Seat Booking</h1>

      <button
        onclick="logout()"
        class="px-4 py-2 bg-red-500 hover:bg-red-400 text-white rounded-md"
      >
        Logout
      </button>
    </div>

    <div class="max-w-5xl mx-auto mt-10 bg-white p-8 rounded-xl shadow">
      <h2 class="text-2xl font-semibold text-gray-800 text-center mb-2">
        Now Showing: Dhurandhar The Revenge
      </h2>

      <p class="text-center text-gray-500 mb-8">Click a seat to book</p>

      <div class="flex justify-center gap-8 mb-8 text-sm">
        <div class="flex items-center gap-2">
          <span class="w-4 h-4 bg-green-500 rounded"></span>
          <span>Available</span>
        </div>

        <div class="flex items-center gap-2">
          <span class="w-4 h-4 bg-gray-400 rounded"></span>
          <span>Booked</span>
        </div>
      </div>

      <div class="flex justify-center">
        <table id="tbl" class="border-separate border-spacing-3"></table>
      </div>
    </div>

    <script>
      // redirect kr rhe h user ko if he is not logged in..
      const token = localStorage.getItem("token");
      if (!token) {
        window.location.href = "/login";
      }

      async function run() {
        const tbl = document.getElementById("tbl");
        tbl.innerHTML = "";

        const res = await fetch("/seats");
        const seats = (await res.json()).sort((a, b) => a.id - b.id);

        let tr;

        for (let i = 0; i < seats.length; i++) {
          if (i % 8 === 0) tr = document.createElement("tr");

          const td = document.createElement("td");
          const id = seats[i].id;

          if (seats[i].isbooked) {
            td.className =
              "w-16 h-16 rounded-lg bg-gray-300 text-gray-600 font-semibold text-center align-middle cursor-not-allowed";

            td.innerHTML = `
  <div class="relative group w-full h-full flex items-center justify-center">
    ${id}

    <div class="absolute bottom-full mb-2 px-2 py-1 text-xs bg-black text-white rounded opacity-0 group-hover:opacity-100 transition whitespace-nowrap">
      ${seats[i].name}
    </div>
  </div>
`;
          } else {
            td.className =
              "w-16 h-16 rounded-lg bg-green-500 text-white font-semibold text-center align-middle cursor-pointer hover:bg-green-400";

            td.innerText = id;

            td.addEventListener("click", async () => {
              try {
                const r = await fetch(`/${id}`, {
                  method: "PUT",
                  headers: {
                    Authorization: localStorage.getItem("token"),
                  },
                });

                const data = await r.json();

                if (data.error) {
                  alert("Seat already booked");
                } else {
                  alert("Booked successfully!");
                  run();
                }
              } catch (e) {
                alert("Error booking seat");
              }
            });
          }

          tr.appendChild(td);
          tbl.appendChild(tr);
        }
      }

     
      function logout() {
        localStorage.removeItem("token");
        window.location.href = "/login";
      }

      run();
    </script>
  </body>
</html>
